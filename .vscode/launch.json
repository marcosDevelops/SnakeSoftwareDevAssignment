{
  "configurations": [
      {
          "name": "micro:bit OpenOCD Cortex Debug",
          "cwd": "${workspaceFolder}",
          "executable": "build/MICROBIT",
          "request": "launch",
          "type": "cortex-debug",
          "servertype": "openocd",
          "configFiles": [
            "interface/cmsis-dap.cfg",
            "target/nrf52.cfg"
          ],
          "interface": "swd",
          "preLaunchCommands": [
            "load build/MICROBIT",
            "enable breakpoint",
            "monitor reset"
          ]
      }
  ]
}